# ==========================================================
# DrinkIt Frontend Environment Configuration
# ==========================================================
# All sensitive MSG91 authentication secrets reside strictly on the server:
# See server/.env.example for backend configuration.

# Backend API base URL for deployed frontend (e.g. Vercel)
# Production example: https://<render-backend>.onrender.com
# Development fallback: http://127.0.0.1:5001
VITE_API_BASE_URL=

# Socket.IO delivery tracking URL
# Production example: https://<render-backend>.onrender.com
# If omitted, falls back to VITE_API_BASE_URL / http://127.0.0.1:5001
VITE_SOCKET_URL=

# Production frontend URL allowed by backend CORS (configured in Render backend env)
# Example: https://<drinkit-frontend>.vercel.app
CLIENT_URL=
