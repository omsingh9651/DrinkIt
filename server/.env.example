# ================================================================
# DrinkIt Backend Configuration (SERVER ONLY - NEVER EXPOSED)
# ================================================================

# Note: Port 5001 is used to avoid macOS ControlCenter/AirPlay port 5000 conflict
PORT=5001

# ----------------------------------------------------------------
# Admin Portal Authentication (Phase 1)
# ----------------------------------------------------------------
ADMIN_EMAIL=admin@drinkit.com

# Generate with: node server/scripts/generateAdminHash.js "YourPasswordHere"
ADMIN_PASSWORD_HASH=

# Secure JWT signing secret (minimum 32 characters)
ADMIN_JWT_SECRET=your_super_secret_jwt_signing_key_change_in_production

# ----------------------------------------------------------------
# Customer MSG91 OTP Authentication (Preserved)
# ----------------------------------------------------------------
# MSG91 Master Account AuthKey
MSG91_AUTH_KEY=

# MSG91 OTP Widget ID
MSG91_WIDGET_ID=

# Optional: MSG91 Template ID
MSG91_TEMPLATE_ID=

# ----------------------------------------------------------------
# MongoDB Database Configuration (Permanent Data Persistence)
# ----------------------------------------------------------------
# For local MongoDB: mongodb://127.0.0.1:27017
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=drinkit

# ----------------------------------------------------------------
# Razorpay Test Mode Configuration (Test Keys - Never Exposed to Frontend)
# ----------------------------------------------------------------
# Generate from https://dashboard.razorpay.com (Settings -> API Keys in Test Mode)
# Key ID must start with rzp_test_
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourTestKeySecretHere


